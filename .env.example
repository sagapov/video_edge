# Video Edge Service Configuration

# RTMP server port
RTMP_PORT=1935

# HTTP server port (for node-media-server stats)
HTTP_PORT=8000

# API server port
API_PORT=3000

# Default streaming providers (comma-separated RTMP URLs)
# Example: rtmp://live.twitch.tv/app/YOUR_KEY,rtmp://a.rtmp.youtube.com/live2/YOUR_KEY
DEFAULT_PROVIDERS=
